# Copy this file to .env.local and fill in real values.
# Every one of these must also be set in Vercel -> Project -> Settings ->
# Environment Variables, or the matching feature breaks in production.

# Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Same page, "service_role" key. Server-only — never expose this to the
# browser. Used to write plan/usage rows that users can't write themselves.
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com -> API Keys. Powers site generation and editing.
ANTHROPIC_API_KEY=

# Stripe -> Developers -> API keys. Use the live key in production.
STRIPE_SECRET_KEY=
# Stripe -> Developers -> Webhooks -> your endpoint -> "Signing secret".
# The endpoint URL is https://your-domain.com/api/stripe-webhook and it
# must send: checkout.session.completed, invoice.payment_succeeded,
# customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=

# Google Cloud -> APIs & Services -> Credentials, with the "Places API
# (New)" enabled. Powers the Find Leads tab.
GOOGLE_PLACES_API_KEY=

# pexels.com/api -> free, no credit card. Powers real, niche-matching
# stock photos on generated sites (e.g. an actual bakery photo for a
# bakery, not a random unrelated one). Generation still works without
# this — it just falls back to generic Picsum placeholder photos.
PEXELS_API_KEY=

# Vercel -> Account Settings -> Tokens. Lets the app attach a client's
# custom domain to this Vercel project on their behalf.
VERCEL_API_TOKEN=
# Vercel -> Project -> Settings -> General -> "Project ID"
VERCEL_PROJECT_ID=
# Only needed if the project lives under a Vercel team rather than a
# personal account. Leave blank otherwise.
VERCEL_TEAM_ID=

# Email allowed to view /admin/referrals. Defaults to malichiliam@gmail.com
# if unset — only set this if that ever changes.
ADMIN_EMAIL=

# Resend -> API Keys. Powers the lead-notification email sent to a
# client's business owner from app/api/site-lead, and the trial nudge
# emails sent from app/api/cron/trial-nudges.
RESEND_API_KEY=
# Any random string. Vercel Cron automatically sends this as a Bearer
# token when it calls /api/cron/trial-nudges, so this is what stops
# anyone else from triggering it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This route is a no-op (does nothing, sends nothing) until this is set —
# setting it is what turns trial nudges on for the first time.
CRON_SECRET=

# Twilio -> Console. Powers the AI receptionist: buying numbers, and
# proving that a request to /api/voice/* really came from Twilio.
# Without TWILIO_AUTH_TOKEN every voice webhook rejects every request,
# which is the correct behaviour for an unconfigured deployment — an open
# phone webhook writes rows into customer dashboards and spends API
# credit on every request.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The public origin Twilio was configured with, e.g. https://sitebric.com
# Signatures are computed over this exact string. It is NOT read from the
# request, because behind Vercel's proxy the request reports an internal
# host — and a forwarded-host header is attacker-controlled.
PUBLIC_BASE_URL=https://sitebric.com

# Which voice the AI receptionist speaks in. Optional — defaults to
# Polly.Joanna-Neural. Any voice name Twilio accepts works, e.g.
# Polly.Matthew-Neural or Polly.Danielle-Neural. A name Twilio does not
# recognise makes it fall back to its own robotic default, so change this
# one at a time and ring the number to hear it.
RECEPTIONIST_VOICE=
